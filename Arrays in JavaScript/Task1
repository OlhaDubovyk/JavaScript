// Масив чисел
const numbers = [2, -5, 0, 7, -3, 0, 10, -8];
 
// Лічильники для кожного типу чисел
let positiveCount = 0;
let negativeCount = 0;
let zeroCount = 0;
 
// Перебираємо кожен елемент масиву
for (let i = 0; i < numbers.length; i++) {
  // Перевіряємо чи число позитивне, негативне або нульове
  if (numbers[i] > 0) {
    positiveCount++;
  } else if (numbers[i] < 0) {
    negativeCount++;
  } else {
    zeroCount++;
  }
}
 
// Виводимо результат
console.log("Positive numbers count:", positiveCount);
console.log("Negative numbers count:", negativeCount);
console.log("Zero numbers count:", zeroCount);